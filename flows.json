    {
        "id": "1c5f57cde0342a2b",
        "type": "function",
        "z": "9354d92f2cd0f1be",
        "name": "Alarm",
        "func": "const risk = Number(msg.payload || 0);\nconst wasHigh = flow.get(\"risk_was_high\") || false;\n\nif (risk > 70 && !wasHigh) {\n    flow.set(\"risk_was_high\", true);\n    msg.payload = `High risk detected: ${risk}%`;\n    return msg;\n}\n\nif (risk <= 70 && wasHigh) {\n    flow.set(\"risk_was_high\", false);\n}\n\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 650,
        "y": 600,
        "wires": [
            [
                "8764250a23052be6"
            ]
        ]
    },
