    {
        "id": "25c6ad788c513602",
        "type": "function",
        "z": "9354d92f2cd0f1be",
        "name": "Cloud Alarm",
        "func": "let data = msg.payload;\nlet text = \"\";\n\n// Accept either plain string or JSON\nif (typeof data === \"string\") {\n    try {\n        data = JSON.parse(data);\n    } catch (e) {\n        text = data;\n    }\n}\n\nif (!text) {\n    if (data.alert) {\n        text = data.alert;\n    } else if (data.message) {\n        text = data.message;\n    } else {\n        text = JSON.stringify(data);\n    }\n}\n\n// build one log entry\nconst now = new Date().toLocaleString();\nconst entry = {\n    time: now,\n    text: text\n};\n\n// get existing log from flow context\nlet logs = flow.get(\"cloud_alert_logs\") || [];\n\n// newest first\nlogs.unshift(entry);\n\n// keep only latest 20\nlogs = logs.slice(0, 20);\n\nflow.set(\"cloud_alert_logs\", logs);\n\n// send whole log list to template\nmsg.payload = logs;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 350,
        "y": 1040,
        "wires": [
