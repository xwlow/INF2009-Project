    {
        "id": "04a137f04f263282",
        "type": "ui_template",
        "z": "9354d92f2cd0f1be",
        "group": "0d1563d941e60cb0",
        "name": "",
        "order": 7,
        "width": 0,
        "height": 0,
        "format": "<div style=\"padding:8px;\">\n    <h3 style=\"margin-top:0;\">Whitelist</h3>\n    <table style=\"width:100%; border-collapse:collapse; text-align:left;\">\n        <thead>\n            <tr>\n                <th style=\"border-bottom:1px solid #ccc; padding:8px;\">Car Plate</th>\n                <th style=\"border-bottom:1px solid #ccc; padding:8px;\">Entry Frequency</th>\n            </tr>\n        </thead>\n        <tbody>\n            <tr ng-repeat=\"row in msg.payload track by $index\">\n                <td style=\"border-bottom:1px solid #eee; padding:8px;\">{{row.carplate}}</td>\n                <td style=\"border-bottom:1px solid #eee; padding:8px;\">{{row.entry_frequency}}</td>\n            </tr>\n            <tr ng-if=\"!msg.payload || msg.payload.length === 0\">\n                <td colspan=\"2\" style=\"padding:8px;\">No whitelist data</td>\n            </tr>\n        </tbody>\n    </table>\n</div>",
        "storeOutMessages": true,
