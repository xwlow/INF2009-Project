    {
        "id": "e4855818b77f3424",
        "type": "function",
        "z": "9354d92f2cd0f1be",
        "name": "displaywhitelist",
        "func": "let data = msg.payload;\n\nif (typeof data === \"string\") {\n    data = JSON.parse(data);\n}\n\nif (!Array.isArray(data)) {\n    msg.payload = [];\n    return msg;\n}\n\nmsg.payload = data.map(row => ({\n    carplate: String(row[\"Car Plate\"] || \"\")\n        .trim()\n        .toUpperCase(),\n    entry_frequency: Number(row[\"Entry Frequency\"] || 0)\n}));\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 320,
        "y": 960,
