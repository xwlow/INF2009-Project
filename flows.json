    {
        "id": "f5ed891be3155697",
        "type": "function",
        "z": "9354d92f2cd0f1be",
        "name": "light noti",
        "func": "const currentStatus = msg.payload.status;\nconst previousStatus = flow.get(\"last_light_status\");\n\nif (!currentStatus) {\n    return null;\n}\n\nif (previousStatus === undefined) {\n    flow.set(\"last_light_status\", currentStatus);\n    return null;\n}\n\nif (currentStatus !== previousStatus) {\n    flow.set(\"last_light_status\", currentStatus);\n\n    if (currentStatus === \"dark\") {\n        msg.payload = \"Light level is low: DARK\";\n    } else if (currentStatus === \"bright\") {\n        msg.payload = \"Light level is normal: BRIGHT\";\n    } else {\n        msg.payload = \"Light status changed: \" + currentStatus;\n    }\n\n    return msg;\n}\n\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
