    {
        "id": "8d8ebea75b2b76d0",
        "type": "function",
        "z": "9354d92f2cd0f1be",
        "name": "carplate add/remove",
        "func": "const carplate = String(msg.payload.carplate || \"\")\n    .trim()\n    .toUpperCase()\n    .replace(/\\s+/g, \"\");\n\nconst action = String(msg.payload.action || \"\")\n    .trim()\n    .toLowerCase();\n\nif (!carplate) {\n    return null;\n}\n\nif (![\"add\", \"remove\"].includes(action)) {\n    return null;\n}\n\nmsg.payload = {\n    action: action,\n    carplate: carplate\n};\n\nreturn msg;",
